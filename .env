# ╔══════════════════════════════════════════════════════════════════════════╗
# ║              StreamBot — Environment Configuration                       ║
# ║  Copy this to .env and fill in your values.                             ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8142138110:AAF8MD5U_nieKuL_vmxU9eVlG0uFMiOwpns

# Comma-separated Telegram user IDs of bot admins
TELEGRAM_ADMIN_IDS=[7836502250]

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── FFMPEG ────────────────────────────────────────────────────────────────────
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# Maximum recording duration in seconds (default: 2 hours)
FFMPEG_DEFAULT_TIMEOUT=7200
# Buffer size for HLS streams
FFMPEG_BUFFER_SIZE=32M

# ── STORAGE ───────────────────────────────────────────────────────────────────
# local | gdrive | telegram
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data
# Maximum disk used by bot (GB)
MAX_DISK_USAGE_GB=50.0
# Auto-delete recordings after N hours
FILE_RETENTION_HOURS=72

# ── RATE LIMITS ───────────────────────────────────────────────────────────────
# Max messages per user per window
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=60
# Max simultaneous recordings per user
MAX_CONCURRENT_JOBS_PER_USER=3
# VIP users get double quota (comma-separated IDs)
VIP_USER_IDS=[]

# ── ACCESS CONTROL ────────────────────────────────────────────────────────────
# Leave empty to allow all users
ALLOWED_USER_IDS=[]
# These users are always blocked
BLOCK_USER_IDS=[]

# ── PROGRESS UPDATES ──────────────────────────────────────────────────────────
# How often to edit the progress message (seconds)
PROGRESS_UPDATE_INTERVAL=30

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=/var/log/streambot/bot.log

# ── DASHBOARD (optional) ──────────────────────────────────────────────────────
DASHBOARD_ENABLED=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# CHANGE THIS to a strong random secret!
DASHBOARD_SECRET=change-me-in-production

# ── GOOGLE DRIVE (optional, only if STORAGE_BACKEND=gdrive) ──────────────────
# GDRIVE_CREDENTIALS_FILE=/secrets/gdrive-service-account.json
# GDRIVE_FOLDER_ID=your_google_drive_folder_id

# ── TELEGRAM CHANNEL UPLOAD (optional) ───────────────────────────────────────
# Negative ID of a channel where bot is admin
# TELEGRAM_UPLOAD_CHANNEL_ID=-1001234567890

# ── WATCHDOG ─────────────────────────────────────────────────────────────────
WATCHDOG_ENABLED=true
WATCHDOG_CHECK_INTERVAL=30
